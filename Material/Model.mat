{
    "name": "Model",
    "pipeline": "deferred",
    "shadingModel": "lit",
    "variables": ["uv"],
    "properties": [
      { "type": "sampler2d", "name": "albedo" },
      { "type": "sampler2d", "name": "normal" },
      { "type": "sampler2d", "name": "roughness" },
      { "type": "sampler2d", "name": "metallic" },
      { "type": "sampler2d", "name": "ao" }
    ],
    "domain": "surface",
    "vertexCode": "void materialVertex(inout MaterialVertexInputs material) {\n        material.uv = 0.5 * (getPosition() + vec4(1));\n    }",
    "fragmentCode": "void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.roughness         = texture(materialParams_roughness, variable_uv.xy).r;\n        material.metallic          = texture(materialParams_metallic, variable_uv.xy).r;\n        material.ambientOcclusion  = texture(materialParams_ao, variable_uv.xy).r;\n        material.baseColor.rgb     = texture(materialParams_albedo, variable_uv.xy).rgb;\n        material.normal            = normalize(texture(materialParams_normal, variable_uv.xy).rgb * 2.0 - 1.0);\n    }"
}
