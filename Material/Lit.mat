{
    "name": "lit",
    "shadingModel": "lit",
    "variables": ["uv"],
    "properties": [
      { "type": "float3", "name": "baseColor" },
      { "type": "float",  "name": "roughness" },
      { "type": "sampler2d", "name": "texture" },
      { "type": "mat4",   "name": "textureTransform" }
    ],
    "domain": "surface",
    "vertexCode": "void materialVertex(inout MaterialVertexInputs material) {\n        material.uv = 0.5 * (getPosition() + vec4(1));\n    }",
    "fragmentCode": "void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.roughness = materialParams.roughness;\n        material.metallic = 0.0;\n\n        if (variable_uv.z >= 1.0) {\n            vec2 uv = (materialParams.textureTransform * vec4(variable_uv.xy, 0, 1)).xy;\n            material.baseColor.rgb = inverseTonemapSRGB(texture(materialParams_texture, uv).rgb);\n        } else {\n            material.baseColor.rgb = materialParams.baseColor;\n        }\n    }"
}
